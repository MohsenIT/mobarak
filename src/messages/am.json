  "ui.763063cda7": "መተግበሪያው በማያ ገጹ ላይ እስከተከፈተ ድረስ ማያ ገጹ ይበራል።",
  "ui.cd46e86ad5": "ማያ ገጹን ማብራት አልነቃም፤ መሳሪያው በባትሪ መቆጠቢያ ሁነታ ላይ ሊሆን ይችላል።",
  "ui.b5cbc3b789": "ወደ መተግበሪያው ሲመለሱ፣ ማያ ገጹን ማብራት እንደገና ይነቃል።",
  "ui.8b1995cbd5": "ይህንን አማራጭ በማንቃት፣ በማንበብ ጊዜ ማያ ገጹ በራስ-ሰር አይጠፋም።",
  "ui.dfc48e5fbf": "የማከማቻ ቦታ የለም፤ የዚህ አንቀጽ መሸጎጫ አልተቀመጠም።",
  "ui.4a08c7828a": "ለመቀጠል፣ መልቀቅን ይጫኑ።",
  "ui.823d089129": "ድምጽ አልተገኘም፤ የኢንተርኔት ግንኙነትን ያረጋግጡ እና እንደገና ይሞክሩ።",
  "ui.e3832a276d": "መልቀቅ አልተቻለም፤ እንደገና ይሞክሩ።",
