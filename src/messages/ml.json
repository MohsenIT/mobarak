  "ui.4bfc7b8a3d": "അറബിക്/പേർഷ്യൻ 'ക', 'യ' അക്ഷരങ്ങളിലെ വ്യത്യാസം തിരയലിനെ ബാധിക്കില്ല.",
  "ui.12287cefbb": "തിരയൽ ലോഡ് പരാജയപ്പെട്ടു.",
  "ui.9ec9176e66": "{p0} ആയത്ത് · {p1} പൊരുത്തം",
  "ui.57f03a82b0": "തിരയൽ ഫലങ്ങൾ",
  "ui.07093a152e": "ഫലങ്ങൾ ഫിൽട്ടർ ചെയ്യുക",
  "ui.96ba59563f": "ഫിൽട്ടർ {p0} നീക്കം ചെയ്യുക",
  "ui.1c36b0e132": "ഫിൽട്ടറുകൾ നീക്കം ചെയ്യുക",
  "ui.2c2cdb504e": "എന്താണ് തിരയുന്നത്?",
  "ui.9535464700": "ഒരു വാക്കോ വാചകമോ എഴുതി തിരയൽ പരിധി തിരഞ്ഞെടുക്കുക.",
  "ui.cfd7c4bd1f": "ലാ തഖഫ്",
  "ui.72dbd6c944": "റഹ്മ",
  "ui.e7e17d45e9": "രിസ്ഖ്",
  "ui.be9b8b4f2b": "വീണ്ടും ശ്രമിക്കുക",
  "ui.b548ad6007": "ഫലങ്ങളൊന്നും കണ്ടെത്തിയില്ല",
  "ui.d0c738e420": "വാചകമോ തിരഞ്ഞെടുത്ത സൂറകളോ മാറ്റുക; അടുത്തുള്ള വാക്കുകൾക്കായി 'അക്ഷരത്തെറ്റ് അനുവദിക്കുക' ഓൺ ചെയ്യുക.",
  "ui.a55b5ca0c4": "{p0} ആയത്ത് {p1}-ലേക്ക് പോകുന്നു",
  "ui.f922b82cb1": "· ആയത്ത്",
  "ui.1abf27acd0": "ആയത്തിലേക്ക് പോകുക ←",
  "ui.76f0fc62b1": "വിവർത്തനം ലോഡ് പരാജയപ്പെട്ടു; വീണ്ടും ശ്രമിക്കുക",
  "ui.0c70162476": "കൂടുതൽ ആയത്തുകൾ ·",
  "ui.77e7a9224b": "മുതൽ",
  "ui.314d58e669": "ബാബ് ഫിൽട്ടർ",
  "ui.1dc4cae4ed": "വാക്യഘടന ഫിൽട്ടർ",
  "ui.12706fd406": "ബാബ്",
  "ui.a023ed0970": "കുറവ്",
  "ui.9b083d9135": "+{p0} കൂടുതൽ",
  "ui.1f253d9ad1": "ആയത്ത് പരിധിയുടെ മൂലരൂപ ബന്ധം",
  "ui.0818c8d564": "ഓരോ പൊതുവായ മൂലരൂപത്തിനും സൂറയിലുടനീളം സ്ഥിരമായ നിറം; പരിധിക്കുള്ളിൽ തുടർച്ചയായ അടിവരയും പുറത്ത് ഡാഷ് ചെയ്ത വരയും",
  "ui.5248483502": "താരതമ്യം അടയ്ക്കുക",
  "ui.b8efcc0229": "ആയത്ത് മുതൽ",
  "ui.d754a5658e": "ആയത്ത് വരെ",
  "ui.d5dd708148": "സന്ദർഭം ഉപയോഗിച്ച് വേഗത്തിൽ പൂരിപ്പിക്കുക",
  "ui.9fb079d3da": "താരതമ്യ സന്ദർഭങ്ങൾ",
  "ui.9187e771c5": "സന്ദർഭം {p0} · ആയത്തുകൾ {p1} മുതൽ {p2} വരെ",
  "ui.16836d5471": "സന്ദർഭം",
  "ui.0c6869f553": "പരിധി 1-നും",
  "ui.64a726a962": "ഇടയിലായിരിക്കണം; ആരംഭ ആയത്ത് അവസാനത്തേതിനേക്കാൾ വലുതായിരിക്കരുത്.",
  "ui.c4ed354a4c": "താരതമ്യത്തിനായി, കുറഞ്ഞത് ഒരു ആയത്തെങ്കിലും പരിധിക്ക് പുറത്ത് അവശേഷിക്കണം.",
  "ui.07f0283e87": "എതിരായി",
  "ui.c07b97f990": "ബാക്കിയുള്ള ആയത്ത് ·",
  "ui.895d03a002": "പൊതുവായ മൂലരൂപം",
  "ui.727214f3ae": "റാങ്കുകൾ എങ്ങനെ കണക്കാക്കുന്നു?",
  "ui.f344475e2e": "രണ്ട് ഭാഗങ്ങളിലെ കീവേഡ് സൂചികയുടെ ജ്യാമിതീയ ശരാശരിയിൽ നിന്നാണ് ബന്ധത്തിന്റെ ശക്തി ലഭിക്കുന്നത്; ഓരോ ഭാഗത്തിന്റെയും നീളവും ഖുർആൻ മുഴുവനിലെ മൂലരൂപത്തിന്റെ ആവർത്തനവും കണക്കിലെടുക്കുന്നു. പൊതുവായ ആവർത്തനം എന്നത് രണ്ട് ഭാഗങ്ങളിലെയും കുറഞ്ഞ ഉപയോഗമാണ്. സൂറയുടെ കീവേഡ് എന്നത് മൂലരൂപങ്ങളുടെ പട്ടികയിലെ സൂചികയാണ്. ഈ താരതമ്യം പദാവലിയിലെ പങ്കിടൽ കാണിക്കുന്നു, അർത്ഥപരമായ ബന്ധത്തിന്റെ തെളിവല്ല.",
  "ui.009549d93e": "ബന്ധത്തിന്റെ ശക്തി",
  "ui.c5e1b1d4f5": "പൊതുവായ ആവർത്തനം",
  "ui.e0fcdd0d87": "സൂറയുടെ കീവേഡ്",
  "ui.95ceec00b6": "ഡാറ്റ ലോഡ് ആയില്ല. ടൂൾ അടച്ച് വീണ്ടും തുറക്കുക.",
  "ui.33be2b63d7": "ഈ പരിധിയും സൂറയിലെ ബാക്കി ഭാഗവും തമ്മിൽ പൊതുവായ മൂലരൂപം കണ്ടെത്തിയില്ല.",
  "ui.cdc6fcf112": "ബന്ധം",
  "ui.6ef0a02025": "പരിധിയിൽ:",
  "ui.5313016e63": "തവണ · പുറത്ത്:",
  "ui.0886e42967": "തവണ · സൂറയുടെ കീവേഡ്:",
  "ui.7386dc56bf": "പരിധിയിലെ ആയത്തുകൾ:",
  "ui.645771cd23": "പുറത്തുള്ള ആയത്തുകൾ:",
  "ui.bc757e524c": "സ്ക്രീൻ ഓൺ ആയി നിലനിർത്തുക",
  "ui.ddebea947c": "പാരായണ സമയത്ത് സ്ക്രീൻ ഓൺ ആയി നിലനിർത്തുക",
  "ui.8cd5f86a69": "ഈ ബ്രൗസർ സ്ക്രീൻ ഓൺ ആയി നിലനിർത്തുന്നതിനെ പിന്തുണയ്ക്കുന്നില്ല.",
  "ui.763063cda7": "ആപ്പ് സ്ക്രീനിൽ തുറന്നിരിക്കുന്നിടത്തോളം സ്ക്രീൻ ഓൺ ആയിരിക്കും.",
  "ui.cd46e86ad5": "സ്ക്രീൻ ഓൺ ആയി നിലനിർത്തുന്നത് സജീവമായില്ല; ഉപകരണം ബാറ്ററി സേവർ മോഡിലായിരിക്കാം.",
  "ui.b5cbc3b789": "ആപ്പിലേക്ക് മടങ്ങുമ്പോൾ, സ്ക്രീൻ ഓൺ ആയി നിലനിർത്തുന്നത് വീണ്ടും സജീവമാകും.",
  "ui.8b1995cbd5": "ഈ ഓപ്ഷൻ സജീവമാക്കിയാൽ, വായിക്കുമ്പോൾ സ്ക്രീൻ സ്വയമേവ ഓഫാകില്ല.",
  "ui.dfc48e5fbf": "സ്റ്റോറേജ് സ്പേസ് ലഭ്യമല്ല; ഈ ആയത്തിന്റെ കാഷെ സംരക്ഷിച്ചില്ല.",
  "ui.4a08c7828a": "തുടരാൻ, പ്ലേ അമർത്തുക.",
  "ui.823d089129": "ഓഡിയോ ലഭിച്ചില്ല; ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.",
  "ui.e3832a276d": "പ്ലേ ചെയ്യാൻ സാധിച്ചില്ല; വീണ്ടും ശ്രമിക്കുക.",
  "ui.cb282cb444": "സൂറ {p0} · ആയത്ത് {p1}",
  "ui.f77fdf433a": "ഈ സൂറയുടെ ഓഡിയോ ഓഫ്‌ലൈൻ ഉപയോഗത്തിനായി സംരക്ഷിച്ചു.",
  "ui.3d82b884ee": "ഡൗൺലോഡ് പൂർത്തിയായില്ല; കണക്ഷനോ സ്പേസോ പരിശോധിക്കുക. വീണ്ടും ശ്രമിക്കുമ്പോൾ തുടർച്ചയായി ഡൗൺലോഡ് ചെയ്യും.",
  "ui.69833552b5": "ഓഡിയോ ഫയൽ പ്ലേ ചെയ്യാൻ കഴിയില്ല; വീണ്ടും ശ്രമിക്കുക.",
  "ui.1f7cc9473a": "പാരായണം പ്ലേ ചെയ്യുക",
  "ui.edcffc5849": "പ്ലേ ചെയ്യുന്ന ആയത്തിലേക്ക് പോകുക",
  "ui.a8ca409b79": "മുമ്പത്തെ ആയത്ത്",
  "ui.fe2e1906b8": "പാരായണം താൽക്കാലികമായി നിർത്തുക",
  "ui.add1e314a2": "അടുത്ത ആയത്ത്",
  "ui.d2ac810b00": "പാരായണവും ഡൗൺലോഡ് ക്രമീകരണങ്ങളും",
  "ui.2c65036980": "പാരായണം അടയ്ക്കുക",
  "ui.2ea8f68e72": "പാരായണം",
  "ui.328fa816d6": "· തർതീൽ",
  "ui.48288575ed": "ഖാരി",
  "ui.1dde68b6a8": "ആയത്തിൽ നിന്ന് ആരംഭിക്കുക",
  "ui.991d782fda": "പ്ലേബാക്ക് വേഗത",
  "ui.9645b5c54f": "ഓരോ ആയത്തും ആവർത്തിക്കുക",
  "ui.d303a8c08f": "{p0} തവണ",
  "ui.12fab10c2c": "നിർത്തുന്നത് വരെ",
  "ui.2cfa25518d": "മുഴുവൻ സൂറയും ആവർത്തിക്കുക",
  "ui.e3bdacb9c9": "സ്ക്രീനിൽ ആയത്ത് പിന്തുടരുക",
  "ui.f357dd405c": "പശ്ചാത്തലത്തിൽ പ്ലേ ചെയ്യുന്നത് തുടരുക",
  "ui.e1448c3b31": "സംരക്ഷിച്ച ആയത്ത് ·",
  "ui.9a29784b98": "എംബി",
  "ui.0c77df7fdd": "ആയത്ത് ഡൗൺലോഡ് ചെയ്യുന്നു",
  "ui.f8960d4ff6": "ഡൗൺലോഡ് നിർത്തുക",
  "ui.ac3db18411": "ഓഫ്‌ലൈൻ പ്ലേ ചെയ്യാൻ തയ്യാറാണ്",
  "ui.4078092b65": "ഈ സൂറയുടെ ഓഡിയോ ഡൗൺലോഡ് ചെയ്യുക",
  "ui.398f681786": "ഓഡിയോ നീക്കം ചെയ്യാൻ സാധിച്ചില്ല.",
  "ui.e2188fd0aa": "ഈ സൂറയുടെ സംരക്ഷിച്ച ഓഡിയോ നീക്കം ചെയ്യുക",
  "ui.27e353abc8": "പ്ലേ ചെയ്ത ആയത്തുകൾ 7 ദിവസം വരെ, പരമാവധി 40 എംബി വരെ കാഷെ ചെയ്യപ്പെടുന്നു. മുഴുവൻ സൂറയുടെ ഡൗൺലോഡ് പ്രത്യേകം സൂക്ഷിക്കുന്നു; ആപ്പ് ഡാറ്റ മായ്ച്ചാൽ അതും നീക്കം ചെയ്യപ്പെടും.",
  "ui.bb4cb4db3d": "ഓഡിയോ സ്രോതസ്സ്:",
  "ui.3a0967fbbe": "പതിപ്പുകളുടെ ചരിത്രം",
  "ui.20245d9e19": "പുതിയ പതിപ്പിലെ മാറ്റങ്ങൾ",
  "ui.457dafcc7b": "നിങ്ങളുടെ നിലവിലെ പതിപ്പ്:",
  "ui.449d089d40": " · {p0} പുതിയ പതിപ്പ്",
  "ui.177aa250df": "ഈ അപ്‌ഡേറ്റിനായി പുതിയ വിശദാംശങ്ങളൊന്നും രേഖപ്പെടുത്തിയിട്ടില്ല.",
  "ui.bb810c0981": "പതിപ്പ് {p0}",
  "ui.bfa8430237": "പതിപ്പ് ഡൗൺലോഡ് പരാജയപ്പെട്ടു; കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക.",
  "ui.bae3fdab58": "പിന്നീട്",
  "ui.2a9c64792a": "ഇപ്പോൾ അപ്‌ഡേറ്റ് ചെയ്യുക",
  "ui.6ad327d237": "സ്രോതസ്സുകൾ തിരയുക",
  "ui.558dc6254e": "{p0} തിരഞ്ഞെടുക്കുക",
  "ui.95df295b80": "പേര്, രചയിതാവ്, രാജ്യം, സ്രോതസ്സ് സവിശേഷതകൾ എന്നിവ പ്രകാരം തിരയുക",
  "ui.a24381d8b8": "{p0} തിരയുക",
  "ui.4985474be1": "പേര്, രാജ്യം അല്ലെങ്കിൽ സവിശേഷത...",
  "ui.23625d3dd4": "സ്രോതസ്സ് തരം",
  "ui.82017c312f": "സ്രോതസ്സ് തരം ഫിൽട്ടർ",
  "ui.15270886ea": "എല്ലാം",
  "ui.0ca5a0d367": "രാജ്യം",
  "ui.b0cc9e0ee2": "രാജ്യം ഫിൽട്ടർ",
  "ui.edd0aba98b": "ഭാഷ",
  "ui.89a53b5221": "ഭാഷ ഫിൽട്ടർ",
  "ui.861afdb3c3": "പാരായണ രീതി",
  "ui.f11a305a02": "പാരായണ രീതി ഫിൽട്ടർ",
  "ui.a894ae84a7": "ഈ സവിശേഷതകളുള്ള സ്രോതസ്സ് നിലവിലെ പട്ടികയിലില്ല.",
  "ui.df7eaafe0c": "അൽ-തഹ്ഖീഖ് ഫീ കലിമാത്തിൽ ഖുർആനിൽ കരീം",
  "ui.9c1717f2f2": "മുഅ്ജം മഖായീസിൽ ലുഗ",
  "ui.21e5e1b857": "അൽ-മുഅ്ജം അൽ-ഇഷ്തിഖാഖി അൽ-മുഅസ്സൽ ലി അൽഫാളി ഖുർആനിൽ കരീം",
  "ui.fde1fab404": "{p0} വിവരണം {p1}",
  "ui.b51461903e": "സ്രോതസ്സുകളുടെ പട്ടിക ലോഡ് ആയില്ല; വിശകലന വിഭാഗം വീണ്ടും തുറക്കുക.",
  "ui.fb65d57afe": "അൽ-തഹ്ഖീഖിലെ മൂലരൂപത്തിന്റെ അർത്ഥം",
  "ui.82d30beedd": "മൂലരൂപത്തിന്റെ വിവരണം ലോഡ് ചെയ്യുന്നു...",
  "ui.de392efb74": "ഈ മൂലരൂപത്തിനായി സമർപ്പിച്ച പതിപ്പിൽ പൊരുത്തപ്പെടുന്ന എൻട്രി കണ്ടെത്തിയില്ല.",
  "ui.62115ceb91": "അടുത്തുള്ള അക്ഷരവിന്യാസമുള്ള നിരവധി എൻട്രികളുണ്ട്; ഉദ്ദേശിച്ച അർത്ഥം തിരിച്ചറിയാൻ ഓരോ എൻട്രിയുടെയും പ്രധാന തലക്കെട്ട് നിലനിർത്തിയിട്ടുണ്ട്.",
  "ui.85fc86d95e": "മൂലരൂപങ്ങളുടെ കേന്ദ്ര ആശയത്തിലും അവയുടെ ഖുർആനിക ഉപയോഗങ്ങളിലും ശ്രദ്ധ കേന്ദ്രീകരിച്ചുള്ള ഖുർആൻ പഠനം.",
  "ui.5c1ce6c22d": "അല്ലാമാ ഹസൻ മുസ്തഫവി",
  "ui.af8cf777b5": "അറബിക് പതിപ്പ്",
  "ui.a18c680965": "മൂന്നാം പതിപ്പ്; ദാറുൽ കുതുബിൽ ഇൽമിയ്യ - അല്ലാമാ മുസ്തഫവി കൃതികളുടെ പ്രസാധന കേന്ദ്രം; സമർപ്പിച്ച 14 വാല്യങ്ങളുടെ ശേഖരം",
  "ui.261e287eb1": "സ്രോതസ്സ് എൻട്രി",
  "ui.feaa124276": "സാദിഖ് അബ്ബാസിയും ടെഹ്‌റാൻ സർവ്വകലാശാലയിലെ ഖുർആൻ ആൻഡ് ഇത്ര സ്റ്റുഡന്റ് സ്കൂൾസ് ഗ്രൂപ്പും",
  "ui.d3d669e851": "അൽ-തഹ്ഖീഖ് ആപ്പ് (പേർഷ്യൻ), സമർപ്പിച്ച ഫയൽ",
  "ui.dcdb47133b": "നിർമ്മിത ബുദ്ധി ഉപയോഗിച്ച് തയ്യാറാക്കിയ സംഗ്രഹം സ്രോതസ്സ് വാചകവുമായി പൊരുത്തപ്പെടുത്തിയിട്ടുണ്ട്.",
  "ui.09dc3571b1": "ഈ എൻട്രിയുടെ മലയാളം വിവരണം അറബിക് വാചകത്തിൽ നിന്ന് നിർമ്മിത ബുദ്ധി ഉപയോഗിച്ച് വിവർത്തനം ചെയ്തതും സംഗ്രഹിച്ചതുമാണ്; പുസ്തകത്തിന്റെ അച്ചടിച്ച വിവർത്തനമല്ല.",
  "ui.ee5c6d1595": "വിവർത്തനത്തിന്റെ അവകാശവാദം ആപ്പ് പരിചയപ്പെടുത്തൽ അനുസരിച്ചാണ്; വാല്യം നമ്പർ, പേജ്, പ്രസിദ്ധീകരണ തീയതി എന്നിവ ആപ്പ് ഡാറ്റയിൽ ലഭ്യമല്ല.",
  "ui.1f2aabce53": "എൻട്രി \"",
  "ui.5be0ee3544": "ഖുർആനിലെ ഉപയോഗ ഉദാഹരണം",
