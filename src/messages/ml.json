  "ui.6879ba512c": "വിശകലന വിഭാഗങ്ങളുടെ ക്രമം",
  "ui.0cfb741f7a": "ലോഡ് ചെയ്യുന്നു...",
  "ui.8686dec293": "ഇതൊരു അവ്യയമോ സർവ്വനാമമോ ആണ്, ഇതിന് സ്വതന്ത്രമായ മൂലരൂപമില്ല.",
  "ui.2ad117fe49": "ഈ സൂറയിലെ എണ്ണം",
  "ui.337a72ddb2": "ഖുർആനിലെ ആകെ എണ്ണം",
  "ui.637842efc1": "ഉൾക്കൊള്ളുന്ന സൂറ",
  "ui.743938a57c": "അരികിലുള്ളത്",
  "ui.2907d0355e": "ഈ സൂറയിലെ കീവേഡ് സൂചിക",
  "ui.8b753a8452": "പ്രധാനപ്പെട്ടത്",
  "ui.6eee111ecb": "ഈ മൂലരൂപത്തിന്റെ ആകെ ഉപയോഗത്തിൽ ഈ സൂറയുടെ വിഹിതം",
  "ui.41fdda1a1a": "ഖുർആനിലെ മൂലരൂപ വിതരണം — ചാടാൻ സ്പർശിക്കുക",
  "ui.92649bd7f9": "സന്ദർഭ സ്രോതസ്സ്",
  "ui.2bfd4864cf": "ഈ സൈറ്റിലെ സന്ദർഭ അതിരുകളും ആയത്തുകളുടെ വിഷയപരമായ ബന്ധവും നിർണ്ണയിക്കുന്നതിനുള്ള അവലംബം.",
  "ui.4fc7a5a7c2": "നിർമ്മാതാവ്",
  "ui.e1280ac99b": "പതിപ്പ്",
  "ui.cea73c0237": "സമർപ്പിച്ച PDF ഫയൽ",
  "ui.191f2cdcd2": "പരിധി അടിസ്ഥാനം",
  "ui.b43be2bd00": "ചെറിയ സൂറകൾക്കായി ഉപയോക്താവ് പൂർത്തിയാക്കിയത്",
  "ui.2cc6a9014c": "അവലംബം",
  "ui.f9119fddb7": "പേജ് {p0}",
  "ui.bba0200510": "ഉപയോക്താവിന്റെ പൂർത്തീകരണമനുസരിച്ച് ഈ സൂറയുടെ പരിധി മുഴുവൻ സൂറയായി കണക്കാക്കുന്നു; ഇത് PDF-ൽ നിന്ന് എടുത്തതല്ല.",
  "ui.79d0d683fb": "പരിധികൾ സ്രോതസ്സിന്റെ പ്രാഥമിക സന്ദർഭത്തിൽ നിന്നാണ് എടുത്തത്; ഈ വിഭജനം ഒരു വ്യാഖ്യാന നിർദ്ദേശമാണ്.",
  "ui.1024a32c6c": "സന്ദർഭ രേഖ",
  "ui.662e05e5a4": "സ്രോതസ്സ് പേജ് {p0}",
  "ui.72203547c8": "സന്ദർഭത്തിലെ ആയത്ത്",
  "ui.c8b65fe880": "സന്ദർഭത്തിലെ വാക്ക്",
  "ui.8bbf1cab23": "വ്യത്യസ്ത മൂലരൂപം",
  "ui.1e93a690ed": "സ്രോതസ്സ് ഫയലിൽ ഈ സൂറയുടെ സന്ദർഭ പരിധി വ്യക്തമാക്കിയിട്ടില്ല; ഊഹിച്ചുള്ള പരിധി തിരഞ്ഞെടുക്കുന്നില്ല.",
  "ui.6090105c4a": "{p0} സന്ദർഭങ്ങൾ",
  "ui.3050486f3e": "{p1}-ൽ നിന്നുള്ള {p0} സന്ദർഭം",
  "ui.69a4606f3f": "· ആയത്തുകൾ",
  "ui.b1e000640d": "മുതൽ",
  "ui.6c8483cc24": "ഈ സന്ദർഭത്തെ സൂറയിലെ ബാക്കി ഭാഗവുമായി മൂലരൂപപരമായി താരതമ്യം ചെയ്യുക",
  "ui.05ab2e3ac9": "ഈ സൂറയിലെ സന്ദർഭങ്ങളുടെ പട്ടിക",
  "ui.dcff10738a": "ഈ സൂറയിലെ സന്ദർഭങ്ങൾ",
  "ui.d83f4af983": "ആയത്തുകൾ",
  "ui.34bee90de8": "പേജ് ലോഡ് പരാജയപ്പെട്ടു · വീണ്ടും ശ്രമിക്കുക",
  "ui.d588c14502": "പേജ് ലോഡ് ചെയ്യുന്നു",
  "ui.562b3acae1": "പേജ് നമ്പർ {p0}",
  "ui.d2ef137028": "പേജ്",
  "ui.24cd4b7b61": "തിരഞ്ഞെടുത്ത സ്രോതസ്സിൽ ഈ ആയത്തിന്റെ വിവർത്തനമില്ല.",
  "ui.ad34b65e87": "വിവർത്തനം ലോഡ് ചെയ്യുന്നു...",
  "ui.8ef802f5c5": "വാല്യം {p0}, പേജ് {p1} · ഡിജിറ്റൽ പേജ് {p2}",
  "ui.761913287f": "അൽ-മുഅ്ജം അൽ-ഇഷ്തിഖാഖിയിലെ മൂലരൂപത്തിന്റെ അർത്ഥം",
  "ui.62d9d3f5e8": "മൂലരൂപത്തിന്റെ വിവരണം കാണാൻ തുറക്കുക.",
  "ui.84557ada04": "പൂർണ്ണമായ വിവരണത്തിനായി ഇന്റർനെറ്റുമായി ബന്ധിപ്പിക്കുക അല്ലെങ്കിൽ ക്രമീകരണങ്ങളിൽ നിന്ന് പുസ്തകം ഡൗൺലോഡ് ചെയ്യുക.",
  "ui.bf6915cea1": "ഈ മൂലരൂപത്തിന്റെ എൻട്രി ഇതുവരെ ക്രമീകരിച്ചിട്ടില്ല.",
  "ui.505d12eadc": "ഈ മൂലരൂപത്തിനായി നിരവധി എൻട്രികളും അനുബന്ധങ്ങളും രേഖപ്പെടുത്തിയിട്ടുണ്ട്.",
  "ui.0e9d8dd6af": "ഖുർആനിലെ വാക്കുകളുടെ വ്യുൽപ്പന്ന നിഘണ്ടു, കേന്ദ്ര ആശയത്തിനും ഒരേ മൂലരൂപമുള്ള വാക്കുകളുടെ ബന്ധത്തിനും ഊന്നൽ നൽകുന്നു.",
  "ui.f72a3d8543": "രചയിതാവ്",
  "ui.bcf7493cdd": "ഡോ. മുഹമ്മദ് ഹസൻ ഹസൻ ജബൽ",
  "ui.f45417f62d": "ഡിജിറ്റൽ സ്രോതസ്സ്",
  "ui.478a26d593": "ഷാമില പതിപ്പിൽ നിന്ന് സമർപ്പിച്ച വാചകം",
  "ui.21f1a03e36": "എൻട്രി",
  "ui.09eafea4eb": " · അനുബന്ധം",
  "ui.6089f72b5b": "വാല്യം {p0}, പേജ് {p1}",
  "ui.01f2ad2bc8": "മലയാളം വിവരണം",
  "ui.737f40a75c": "രചയിതാവിന്റെ എൻട്രി വിവർത്തനം ചെയ്തിട്ടുണ്ട്; അടിക്കുറിപ്പുകളും അധ്യായത്തിന്റെ പൊതുവായ വിവരണവും വിവർത്തനത്തിൽ ഉൾപ്പെടുത്തിയിട്ടില്ല.",
  "ui.3324fb7690": "കേന്ദ്ര ആശയത്തിന്റെ സംഗ്രഹം മാത്രമേ മലയാളത്തിൽ തയ്യാറായിട്ടുള്ളൂ; പൂർണ്ണ വിവർത്തനം ഇതുവരെ തയ്യാറായിട്ടില്ല.",
  "ui.df3ff1eba7": "അറബിക് വാചകം സമർപ്പിച്ച ഫയലിൽ നിന്നുള്ളതാണ്; മലയാളം വിവർത്തനം ഇതുവരെ തയ്യാറായിട്ടില്ല.",
  "ui.74d9e31b41": "ഷാമിലയിലെ സ്രോതസ്സ് വാചകം",
  "ui.0e3d4dc287": "ഈ എൻട്രിയുടെ പൂർണ്ണമായ മലയാളം വിവർത്തനം ഇതുവരെ തയ്യാറായിട്ടില്ല.",
  "ui.cc9729c600": "അറബിക് മൂലരൂപം അടയ്ക്കുക",
  "ui.4cf44c4f5c": "അറബിക് മൂലരൂപം കാണുക",
  "ui.ff6e04c560": "സ്രോതസ്സ് പേജുകളിലെ അടിക്കുറിപ്പുകൾ",
  "ui.f6666782cf": "ഈ അടിക്കുറിപ്പുകൾ പേജിന്റേതാണ്, അതേ പേജിലെ മറ്റ് എൻട്രികളുമായി ബന്ധപ്പെട്ടതാകാം.",
  "ui.c986e01e3f": "സ്രോതസ്സ് പേജ്",
  "ui.4be660c170": "മുഹമ്മദ് ഹസൻ ഹസൻ ജബൽ",
  "ui.a901d5ff97": "ഈ പേജിലെ അടിക്കുറിപ്പ് അതേ പേജിലെ മറ്റ് എൻട്രികളുമായി ബന്ധപ്പെട്ടതാകാം.",
  "ui.936818bf1a": "പേജ് കാണുക",
  "ui.07ecc9d417": "അധ്യായത്തിന്റെ പൊതുവായ അർത്ഥം",
  "ui.149f9194ea": "ഭാഗം",
  "ui.5145a3cd1a": "ഈ എൻട്രിയുടെ വാചകം അവലോകനം ചെയ്യേണ്ടതുണ്ട്.",
  "ui.a563cd186a": "അറബിക് മൂലരൂപങ്ങളുടെ നിഘണ്ടു; തെളിവുകളും ഭാഷാപരമായ ഉപയോഗങ്ങളും സഹിതം ഓരോ മൂലരൂപത്തിന്റെയും ആശയപരമായ തത്വങ്ങൾ പരിശോധിക്കുന്നു.",
  "ui.85a2949c23": "അഹ്മദ് ബിൻ ഫാരിസ് ബിൻ സകരിയ്യ; നാലാം നൂറ്റാണ്ട് ഹിജ്റ",
  "ui.5083b63e8d": "മോജാം ശേഖരത്തിൽ പുനഃപ്രസിദ്ധീകരിച്ച വാചക പതിപ്പ്",
  "ui.3073612fe6": "അച്ചടിച്ച പതിപ്പ്",
  "ui.4f36d60b68": "ഈ സ്രോതസ്സിനായി അച്ചടിച്ച വാല്യവും പേജും സ്ഥിരീകരിച്ചിട്ടില്ല",
  "ui.014cd6c9d5": "ഗവേഷകൻ",
  "ui.9bfdcedae1": "അബ്ദുസ്സലാം മുഹമ്മദ് ഹാറൂൺ",
  "ui.ef7127f26a": "സമർപ്പിച്ച പതിപ്പ്",
  "ui.17e06468f0": "മക്തബുൽ ഇഅ്‌ലാമിൽ ഇസ്‌ലാമി; 1404 ഹിജ്റ",
  "ui.f7cff9c45a": "വാല്യം {p0}, പേജ് {p1}{p2}",
  "ui.5e3c5fe7ac": "മലയാളം വിവരണവും സംഗ്രഹവും നിർമ്മിത ബുദ്ധി ഉപയോഗിച്ച് തയ്യാറാക്കിയതാണ്; ഇത് മനുഷ്യൻ പരിശോധിച്ചതല്ല.",
  "ui.f4d0599de5": "സ്രോതസ്സിൽ രേഖപ്പെടുത്തിയ വിട്ടുപോകലുകളോ അവ്യക്തതകളോ ഉണ്ട്.",
  "ui.1ede69cce3": "സ്രോതസ്സിന്റെ വാചക പതിപ്പ്",
  "ui.25622dd345": "മഖായീസിലെ മൂലരൂപത്തിന്റെ അർത്ഥം",
  "ui.a9f13320d9": "ഈ പതിപ്പിൽ രചയിതാവിന്റെ വാചകവും റഫറൻസ് അടിക്കുറിപ്പുകളും ഒരുമിച്ചാണുള്ളത്; അടിക്കുറിപ്പുകൾ അടുത്തുള്ള പേജുമായോ എൻട്രിയുമായോ ബന്ധപ്പെട്ടതാകാം.",
  "ui.8f62241adf": "ഈ എൻട്രിയുടെ സ്രോതസ്സിൽ വിട്ടുപോകലുകളോ അവ്യക്തതകളോ ഉണ്ട്; വിശദീകരണത്തിനായി സ്രോതസ്സ് കാണുക.",
  "ui.5ac12abae1": "മഖായീസ്:",
  "ui.921e6df6ca": "മൂലരൂപത്തിന്റെ വിവരണം ലോഡ് ആയില്ല.",
  "ui.d8d0c75ad5": "ലഭ്യമായ പതിപ്പിൽ, ഈ മൂലരൂപത്തിനായി ഒരു സ്വതന്ത്ര എൻട്രി കൃത്യമായി കണ്ടെത്താനായില്ല.",
  "ui.be62721bd3": "ഈ എൻട്രിയുടെ വിവർത്തനം ഇതുവരെ തയ്യാറായിട്ടില്ല.",
