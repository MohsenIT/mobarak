{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mobarak-issues-bridge",
  "main": "src/bridge-worker.ts",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bridge-db",
      "database_id": "47b1bc8b-ec61-4fbe-ac87-e0a4b0309a85",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GITHUB_REPO": "MohsenIT/mobarak",
    "BALE_CHANNEL_ID": "4357475772",
    "BALE_GROUP_ID": "4961157767",
    "BALE_CHANNEL_USERNAME": "mobarak_issues",
    "BALE_BOT_ID": "1025805170",
    "BRIDGE_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
